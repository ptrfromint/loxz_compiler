class CoffeeMaker {
	init() {
		this.coffee = nil;
	}

	brew(coffee) {
		print "Brewing some " + coffee + "...";
		this.coffee = coffee;
	}

	drink() {
		if (this.coffee) {
			print "Mmm, this " + this.coffee + " is great!";
			this.coffee = nil;
		} else {
			print "Drink what? There's nothing in the cup!";
		}
	}
}

var coffee_maker = CoffeeMaker();
coffee_maker.brew("Espresso");
coffee_maker.drink();
coffee_maker.drink();
