class Person {
	init(name, age) {
		this.name = name;
		this.age = age;
	}

	sayHelloTo(other_person) {
		print "Hello, " + other_person.name + "! My name is " + this.name + "!";
	}
}

class Manager < Person {
	init(name, age, salary) {
		super.init(name, age);
		this.salary = salary;
	}

	announce() {
		print "Hello, my name is " + this.name + ", I'm " + this.age + " years old and I earn $" + this.salary + "!";
	}
}

var person = Person("Joe Button", 30);
var manager = Manager("Manager Button", 45, 50000);
manager.announce();
person.sayHelloTo(manager);
